<?xml version="1.0"?>

<!--==================================================================
This file contains the colors used in each part of the robot
======================================================================-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <material name = "black">
        <color rgba = " 0 0 0 1"/>
    </material>

    <material name = "orange">
        <color rgba = "1 0.647 0 1"/>
    </material>

    <material name = "blue">
        <color rgba = "0 0 1 1"/>
    </material>
</robot>