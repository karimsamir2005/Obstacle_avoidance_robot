<?xml version="1.0"?>

<!--==================================================================
This file contains the main robot description used in rviz and gazebo
======================================================================-->

<robot name = "obstacle_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- <xacro:include filename = "material.xacro"/> -->

<!--===================System Variables (SI units)=========================-->
<xacro:property name ="box_mass" value = "2.5"/>
<xacro:property name ="box_length" value = "0.3"/>
<xacro:property name ="box_width" value = "0.2"/>
<xacro:property name ="box_height" value = "0.1"/>

<xacro:property name ="wheel_mass" value = "0.25"/>
<xacro:property name ="wheel_radius" value = "0.04"/>
<xacro:property name ="wheel_length" value = "0.025"/>

<xacro:property name ="caster_mass" value = "0.05"/>
<xacro:property name ="caster_radius" value = "0.04"/>

<xacro:property name ="radar_mass" value = "0.15"/>
<xacro:property name ="radar_radius" value = "0.035"/>
<xacro:property name ="radar_length" value = "0.04"/>


<!--=================Inertial Xacros for the components===================-->
<xacro:macro name = "box_inertia" params ="m l w h xyz rpy">
    <inertial>
        <origin xyz = "${xyz}" rpy="${rpy}"/>
        <mass value = "${m}"/>
        <inertia ixx="${(m/12.0) * (w*w + h*h)}" ixy="0" ixz="0"
                     iyy="${(m/12.0) * (l*l + h*h)}" iyz="0"
                     izz="${(m/12.0) * (l*l + w*w)}" />
    </inertial>
</xacro:macro>

<xacro:macro name = "wheel_inertia" params = "m r l xyz rpy">
    <inertial>
        <origin xyz = "${xyz}" rpy = "${rpy}"/>
        <mass value = "${m}"/>
        <inertia ixx="${(m/12.0) * (3.0*r*r + l*l)}" ixy="0" ixz="0"
                     iyy="${(m/12.0) * (3.0*r*r + l*l)}" iyz="0"
                     izz="${(m/2.0) * (r*r)}" />
    </inertial>
</xacro:macro>

<xacro:macro name = "caster_inertia" params = "m r xyz rpy">
    <inertial>
        <origin xyz = "${xyz}" rpy = "${rpy}"/>
        <mass value = "${m}"/>
        <inertia ixx="${(2.0/5.0) * m * r * r}" ixy="0" ixz="0"
                     iyy="${(2.0/5.0) * m * r * r}" iyz="0"
                     izz="${(2.0/5.0) * m * r * r}" />
    </inertial>
</xacro:macro>


<!--==========================Link Xacros=================================-->
<xacro:macro name = "generate_wheel" params = "prefix">
    <link name = "${prefix}_link">
        <visual>
            <geometry>
                <cylinder length = "${wheel_length}" radius = "${wheel_radius}"/>
            </geometry>
            <origin xyz = "0 0 0" rpy = "0 0 0"/>
            <material name = "black"/>
        </visual>

        <collision>
            <geometry>
                <cylinder length = "${wheel_length}" radius = "${wheel_radius}"/>
            </geometry>
            <origin xyz = "0 0 0" rpy = "0 0 0"/>
        </collision>

        <xacro:wheel_inertia m = "${wheel_mass}" r = "${wheel_radius}" l = "${wheel_length}"
        xyz = " 0 0 0 " rpy = "0 0 0 "/>
    </link>
</xacro:macro>


<!--===============================Link Defenitions========================-->
<link name="base_link"/>

<!--box link(visual / collision / inertial data)-->
<link name ="box_link">
    <visual>
        <geometry>
            <box size = "${box_length} ${box_width} ${box_height}"/>
        </geometry>
        <origin xyz = " 0 0 0 " rpy = " 0 0 0 "/>
        <material name = "blue"/>
    </visual>

    <collision>
        <geometry>
            <box size = "${box_length} ${box_width} ${box_height}"/>
        </geometry>
        <origin xyz = " 0 0 0 " rpy = " 0 0 0 "/>
    </collision>

    <xacro:box_inertia m = "${box_mass}" l = "${box_length}" w = "${box_width}"
     h = "${box_height}" xyz = " 0 0 0 " rpy = " 0 0 0"  />
</link>


<link name ="radar_link">
    <visual>
        <geometry>
            <cylinder length = "${radar_length}" radius = "${radar_radius}"/>
        </geometry>
        <origin xyz = " 0 0 0" rpy = " 0 0 0"/>
        <material name = "black"/>
    </visual>

    <collision>
            <geometry>
            <cylinder length = "${radar_length}" radius = "${radar_radius}"/>
        </geometry>
        <origin xyz = " 0 0 0" rpy = " 0 0 0"/>
    </collision>

    <xacro:wheel_inertia m = "${radar_mass}" r = "${radar_radius}" l = "${radar_length}"
    xyz = " 0 0 0 " rpy = " 0 0 0"/>
</link>

<!--The Caster wheel link (spherical)-->
<link name = "caster_wheel_link">
    <visual>
        <geometry>
            <sphere radius = "${caster_radius}"/>
        </geometry>
        <origin xyz = " 0 0 0 " rpy = " 0 0 0 "/>
        <material name = "orange"/>
    </visual>


    <collision>
    <geometry>
            <sphere radius = "${caster_radius}"/>
        </geometry>
        <origin xyz = " 0 0 0 " rpy = " 0 0 0 "/>
    </collision>

    <xacro:caster_inertia m = "${caster_mass}" r = "${caster_radius}" xyz = " 0 0 0 " rpy = " 0 0 0"/>
</link>


<!--The two wheels using the xacro made before-->
<xacro:generate_wheel prefix = "wheel1"/>

<xacro:generate_wheel prefix = "wheel2"/>


<!--=================================Joint Defenitions===============================-->
<!--Joint to trasnform from the box_link to the world's base_link-->
<joint name="base_to_box_joint" type="fixed">
    <parent link="base_link"/>
    <child link="box_link"/>
    <origin xyz="0 0 ${box_height/2 + wheel_radius}" rpy="0 0 0"/>
</joint>

<!--Joint to transform wheel1 to the base box_link-->
<joint name = "box_to_wheel1_link" type = "continuous">
    <parent link = "box_link"/>
    <child link = "wheel1_link"/>
    <origin xyz = " ${box_length / 4} ${box_width / 2 + wheel_length / 2} -${box_height / 2} " rpy = " ${pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
</joint>

<!--Joint to transform the second wheel to the base_link-->
<joint name = "box_to_wheel2_link" type  = "continuous">
    <parent link = "box_link"/>
    <child link = "wheel2_link"/>
    <origin xyz = " ${box_length / 4} -${box_width / 2 + wheel_length / 2} -${box_height / 2}" rpy = " ${-pi / 2} 0 0 "/> <!--Because by default the cyulinder is alligned on the z-axis-->
    <axis xyz="0 0 1"/>
</joint>

<!--Joint transforming the caster wheel with the box_link-->
<joint name = "box_to_caster_link" type ="fixed">
    <parent link = "box_link"/>
    <child link = "caster_wheel_link"/>
    <origin xyz = "-${box_length / 2.5} 0 -${box_height / 2}" rpy = " 0 0 0"/>
</joint>

<!--Joint transforming the laser to the box_link-->
<joint name = "box_to_radar_link" type ="fixed">
    <parent link = "box_link"/>
    <child link = "radar_link"/>
    <origin xyz = "0 0 ${(box_height / 2.0) + (radar_length / 2.0)}" rpy = " 0 0 0"/>
</joint>


</robot>
